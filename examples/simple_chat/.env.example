# Copy to .env, add one provider's credentials, then source it in each shell.
DEMO_PROVIDER=openai
DEMO_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-me

# To use the OpenAI-compatible Blablador provider instead, replace the three
# values above and uncomment these two lines.
# BLABLADOR_API_KEY=replace-me
# BLABLADOR_BASE_URL=https://example.invalid/v1

DATABASE_URL=postgresql://juena_demo:juena_demo@127.0.0.1:55433/juena_demo
DEMO_API_URL=http://127.0.0.1:8080
